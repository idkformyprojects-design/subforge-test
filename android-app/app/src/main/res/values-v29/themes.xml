<resources>
    <!-- Android 10+: follow the phone's light/dark setting. -->
    <style name="Theme.SubForge" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <!-- Each screen draws its own header bar (see Screen.kt), which handles Android 15/16 edge-to-edge. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
